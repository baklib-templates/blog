{% layout false %}
{% assign pages = site.pages['/'].children_in_list | order_by: '-created_at' | limit: 5 %}

<!DOCTYPE html>
<html class="scroll-smooth bg-base-100" lang="{{ site.language }}">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="author" content="Baklib">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% meta_tags %}
    {% render 'theme_runtime_colors' %}
    {{ 'stylesheets/application.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'baklib/shared/main.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'baklib/shared/main.js' | asset_url | script_tag: data-turbo-track: 'reload' }}
    {{ 'javascripts/application.js' | asset_url | script_tag: defer: true, data-turbo-track: 'reload' }}
    {% if false %} {{ 'javascripts/cdn.tailwindcss.js' | asset_url | script_tag: data-turbo-track: 'reload' }} {% endif %}
    {{ site.settings.head_html }}
  </head>

  <body class="min-h-screen bg-base-100 antialiased text-base-content">
    <div class="mx-auto min-h-screen max-w-3xl px-4 py-8 sm:px-6 lg:max-w-4xl lg:py-12">
      <header class="mb-10 border-b border-base-300 pb-8">
        <a
          href="{{ site.index_path }}"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-base-content/60 transition-colors hover:text-accent"
        >
          {% render 'icon', name: 'arrow-left', class: 'h-4 w-4' %}
          {{ 'generic.back_to_home' | t }}
        </a>
        <h1 class="mt-6 text-2xl font-semibold tracking-tight text-accent md:text-3xl">
          {{ 'generic.recent_updates' | t }}
        </h1>
        <p class="mt-2 text-sm text-base-content/60">
          {{ 'generic.recent_memo_note' | t }}
        </p>
      </header>

      <div class="space-y-4">
        {% for page in pages %}
          {% assign display_tags = page.settings.tags %}
          {% assign display_tags_size = display_tags | size %}
          {% if display_tags_size == 0 %}
            {% assign display_tags = page.tags %}
          {% endif %}

          {% assign thumb_image_url = page.settings.thumb_image_url | presence %}
          <article class="overflow-hidden rounded-box border border-base-300 bg-base-100 p-4 shadow-sm sm:p-5">
            <div class="flex flex-col gap-4 sm:flex-row sm:gap-5">
              <a
                href="{{ page.path }}"
                class="group/thumb relative block shrink-0 overflow-hidden rounded-box border border-base-300 bg-base-200 sm:w-40 sm:self-start aspect-[16/10] sm:aspect-[4/3] sm:h-28"
                aria-hidden="true"
                tabindex="-1"
              >
                {% if thumb_image_url %}
                  <img
                    src="{{ thumb_image_url }}"
                    alt=""
                    class="h-full w-full object-cover transition duration-300 group-hover/thumb:scale-[1.03]"
                    loading="lazy"
                  />
                {% else %}
                  <div class="flex h-full w-full items-center justify-center text-base-content/40">
                    {% render 'icon', name: 'image', class: 'h-10 w-10' %}
                  </div>
                {% endif %}
              </a>

              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2 text-xs text-base-content/60">
                  {% if page.published_at %}
                    <time datetime="{{ page.published_at | date: '%Y-%m-%d' }}" class="inline-flex items-center gap-1 font-mono">
                      {% render 'icon', name: 'calendar-clock', class: 'h-3.5 w-3.5 shrink-0' %}
                      {{ page.published_at | date: "%Y-%m-%d" }}
                    </time>
                  {% endif %}

                  {% for tag in display_tags %}
                    <a
                      href="{{ tag.path }}"
                      class="rounded-selector bg-base-200 px-2 py-0.5 text-[11px] font-medium text-base-content/80 transition-colors hover:bg-base-300"
                    >
                      {{ tag.name }}
                    </a>
                  {% endfor %}
                </div>

                <h2 class="mt-3 text-lg font-semibold leading-snug tracking-tight text-accent">
                  <a href="{{ page.path }}" class="transition-colors hover:text-base-content/70">{{ page.link_text }}</a>
                </h2>

                {% if page.settings.description %}
                  <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-base-content/60">
                    {{ page.settings.description | strip_html }}
                  </p>
                {% endif %}

                {% render 'sub_page_list', page: page, per: 5 %}
              </div>
            </div>
          </article>
        {% else %}
          <div class="rounded-box border border-dashed border-base-300 bg-base-200/50 px-6 py-16 text-center text-sm text-base-content/60">
            {{ 'generic.empty' | t }}
          </div>
        {% endfor %}
      </div>
    </div>
  </body>
</html>
