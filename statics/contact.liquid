<div class="flex-1 bg-base-100">
  {% render 'breadcrumb', breadcrumb: page.breadcrumb, page: page %}

  <div class="page-container py-10 lg:py-14">
    <article class="mx-auto max-w-2xl">
      <header class="mb-10 text-center">
        <h1 class="text-3xl font-semibold text-accent">{{ page.link_text }}</h1>
        {% if page.settings.description %}
          <p class="mt-3 text-base-content/70">{{ page.settings.description }}</p>
        {% endif %}
      </header>

      {% form_collection "contact" %}
    </article>
  </div>
</div>

{% schema %}
  {
    "name": "t:schema.templates.statics.contact.name",
    "description": "t:schema.templates.statics.contact.description",
    "thumb_url": "images/theme/${lang}/page.png",
    "settings": [
      {
        "id": "title",
        "type": "text",
        "label": "t:schema.templates.statics.contact.settings.title.label",
        "info": "t:schema.templates.statics.contact.settings.title.info"
      },
      {
        "id": "description",
        "type": "textarea",
        "label": "t:schema.templates.statics.contact.settings.description.label"
      }
    ]
  }
{% endschema %}
