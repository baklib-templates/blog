{% layout "theme" %}

<div class="flex-1 bg-base-100">
  <div class="page-container py-10 lg:py-14">
    <header class="mb-12 border-b border-base-300 pb-8">
      <h1 class="text-2xl font-semibold tracking-tight text-accent md:text-3xl">
        {{ 'generic.all_tags' | t }}
      </h1>
      <p class="mt-2 text-sm text-base-content/60">{{ 'generic.tags_page_description' | t }}</p>
    </header>

    {% assign tags_count = site.tags | size %}
    {% if tags_count > 0 %}
      <div class="space-y-16 md:space-y-20">
        {% for tag in site.tags %}
          <section id="tag-section-{{ forloop.index }}" class="scroll-mt-24">
            <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-base-300 pb-4">
              <h2 class="flex min-w-0 items-center gap-3 text-xl font-semibold tracking-tight text-accent md:text-2xl">
                {% if tag.color %}
                  <span
                    class="h-3 w-3 shrink-0 rounded-full ring-2 ring-base-100 ring-offset-1"
                    style="background-color: {{ tag.color }};"
                    aria-hidden="true"
                  ></span>
                {% endif %}
                <a href="{{ tag.path }}" class="transition-colors hover:text-base-content/70">{{ tag.name }}</a>
              </h2>
            </div>

            {% paginate_tag tag.pages, as: 'tag_preview_pages', per: 4 %}
              {% if paginate.total_count > 0 %}
                <div class="grid grid-cols-1 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
                  {% for article in tag_preview_pages %}
                    {% render 'card_grid', page: article %}
                  {% endfor %}
                </div>

                {% if paginate.total_count > 4 %}
                  <div class="mt-8 flex justify-center sm:justify-end">
                    <a href="{{ tag.path }}" class="btn btn-outline btn-sm gap-1">
                      {{ 'generic.view_more' | t }}
                      {% render 'icon', name: 'chevron-right', class: 'h-4 w-4' %}
                    </a>
                  </div>
                {% endif %}
              {% else %}
                <p class="py-8 text-center text-sm text-base-content/60">{{ 'generic.empty' | t }}</p>
              {% endif %}
            {% endpaginate_tag %}
          </section>
        {% endfor %}
      </div>
    {% else %}
      <div class="rounded-box border border-dashed border-base-300 bg-base-200/50 px-6 py-16 text-center text-sm text-base-content/60">
        {{ 'generic.empty' | t }}
      </div>
    {% endif %}
  </div>
</div>
