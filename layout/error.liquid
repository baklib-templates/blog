<!DOCTYPE html>
<html class="bg-base-100" lang="{{ site.language }}">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% meta_tags %}
    {%- comment -%} Same runtime color mapping as layout/theme.liquid {%- endcomment -%}
    {% render 'theme_runtime_colors' %}

    {{ 'stylesheets/application.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'baklib/shared/main.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'javascripts/application.js' | asset_url | script_tag: defer: true, data-turbo-track: 'reload' }}
  </head>
  <body class="flex min-h-screen flex-col bg-base-100 text-base-content antialiased">
    {{ content_for_layout }}
  </body>
</html>
