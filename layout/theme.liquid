<!DOCTYPE html>
<html class="scroll-smooth bg-base-100" lang="{{ site.language }}">
  <head>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="author" content="Baklib">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% meta_tags %}
    {%- comment -%}
      Runtime color injection for admin customization. Static tokens live in
      src/stylesheets/application.css. Brand spec: /p/brand (statics/brand.liquid).
    {%- endcomment -%}
    {% render 'theme_runtime_colors' %}

    {{ 'stylesheets/application.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'baklib/shared/main.css' | asset_url | stylesheet_tag: data-turbo-track: 'reload' }}
    {{ 'baklib/shared/main.js' | asset_url | script_tag: data-turbo-track: 'reload' }}
    {{ 'javascripts/application.js' | asset_url | script_tag: defer: true, data-turbo-track: 'reload' }}
    {%# Enable for low-code platform dev: uncomment the line below %}
    {% if false %} {{ 'javascripts/cdn.tailwindcss.js' | asset_url | script_tag: data-turbo-track: 'reload' }} {% endif %}
    {{ site.settings.head_html }}
  </head>
  <body id="js--body" class="flex min-h-screen flex-col bg-base-100 antialiased text-base-content">
    <div class="flex-0">
      {% if site.settings.is_allow_header %}
        {% render 'header' %}
      {% endif %}
    </div>

    <main class="relative flex min-h-0 flex-1 flex-col bg-base-100{% if site.settings.is_allow_header %} pt-[var(--header-height)]{% endif %}">
      {{ content_for_layout }}
    </main>

    <div class="flex-0">
      {% if site.settings.is_allow_footer %}
        {% render 'footer' %}
      {% endif %}
    </div>
  </body>
</html>
