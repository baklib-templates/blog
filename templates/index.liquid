{% assign sort_mode = params.sort | default: 'published_desc' %}
{% unless sort_mode == 'published_asc' %}
  {% assign sort_mode = 'published_desc' %}
{% endunless %}

{% case sort_mode %}
  {% when 'published_asc' %}
    {% assign sort_field = 'published_at' %}
  {% else %}
    {% assign sort_field = '-published_at' %}
{% endcase %}

{% assign pages = site.pages['/'].pages_in_list | order_by: sort_field %}

<div class="flex-1 bg-base-100">
  {% render 'index_hero', page: page %}

  <div class="page-container py-10 lg:py-14">
    {% render 'tags_toolbar', sort_base: site.index_path, sort_mode: sort_mode %}

    {% paginate_tag pages, per: 9 %}
      <div class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
        {% for article in pages %}
          {% render 'card_grid', page: article %}
        {% else %}
          <div class="col-span-full py-24 text-center text-sm text-base-content/60">{{ 'generic.empty' | t }}</div>
        {% endfor %}
      </div>

      {% if paginate.total_count > 0 %}
        <div class="mt-14 flex justify-center border-t border-base-300 pt-10">
          {% render 'paginate', paginate: paginate %}
        </div>
      {% endif %}
    {% endpaginate_tag %}

    {% comment %} 联系表单区域 - 通过 FormCollection 功能嵌入 {% endcomment %}
    <section class="page-container py-14 border-t border-base-300 mt-14">
      <div class="mx-auto max-w-lg">
        <h2 class="text-2xl font-semibold text-center text-accent mb-2">{{ 'forms.contact.section_title' | t }}</h2>
        <p class="text-sm text-center text-base-content/70 mb-8">{{ 'forms.contact.section_description' | t }}</p>
        {% form_collection "contact" %}
      </div>
    </section>
  </div>
</div>

{% schema %}
  {
    "name": "t:schema.templates.index_card.name",
    "description": "t:schema.templates.index_card.description",
    "thumb_url": "images/theme/${lang}/index.png",
    "preview_image_urls": [
      "images/theme/${lang}/index.png"
    ],
    "sub_page_templates": ["page"],
    "settings": [
      {
        "id": "title",
        "type": "text",
        "label": "t:schema.templates.index_hero.settings.title.label",
        "info": "t:schema.templates.index_hero.settings.title.info"
      },
      {
        "id": "description",
        "type": "textarea",
        "label": "t:schema.templates.index_hero.settings.description.label",
        "info": "t:schema.templates.index_hero.settings.description.info"
      },
      {
        "id": "hero_image_url",
        "type": "image_picker",
        "ratio": "21:9",
        "width": 320,
        "label": "t:schema.templates.index_hero.settings.hero_image_url.label"
      }
    ]
  }
{% endschema %}
