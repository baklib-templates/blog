<div class="flex-1 bg-base-100">
  {% render 'breadcrumb', breadcrumb: page.breadcrumb, page: page %}

  <div class="page-container py-10 lg:py-14">
    {% assign page_title = page.link_text | presence %}
    {% assign page_thumb_image_url = page.settings.thumb_image_url | presence %}
    {% assign page_description = page.settings.description | presence %}
    {% assign page_content = page.settings.content | presence %}

    <article class="mx-auto max-w-4xl">

      <header class="mb-8 border-b border-base-300 pb-8">
        <div class="flex flex-wrap items-center gap-2 text-xs text-base-content/70 md:text-sm">
          {% for tag in page.settings.tags %}
            <a href="{{ tag.path }}" class="rounded-full bg-base-200 px-2.5 py-1 text-xs font-medium text-base-content transition-colors hover:bg-base-300 md:text-sm">
              {{ tag.name }}
            </a>
          {% endfor %}

          {% assign version_count = page.versions | size %}
          {% if version_count > 0 %}
            <span class="text-base-content/30">·</span>
            <ul class="flex flex-wrap items-center gap-1">
              <li>
                <a href="{{ page.path }}" class="rounded-field border border-base-300 px-2 py-0.5 text-base-content/80 hover:bg-base-200">{{ 'templates.page.current_version' | t }}</a>
              </li>
              {% for version_page in page.versions %}
                <li>
                  <a href="{{ version_page.path | append: '?version=' | append: version_page.name }}" class="rounded-field border border-base-300 px-2 py-0.5 text-base-content/80 hover:bg-base-200">{{ version_page.name }}</a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}

          {% if page.published_at %}
            <span class="text-base-content/30">·</span>
            <time datetime="{{ page.published_at | date: '%Y-%m-%d' }}" class="inline-flex items-center gap-1 font-mono text-base-content/60">
              {% render 'icon', name: 'calendar-clock', class: 'h-4 w-4 shrink-0' %}
              {{ page.published_at | date: "%Y-%m-%d" }}
            </time>
          {% endif %}

          {% if site.settings.is_show_visit_count %}
            <span class="text-base-content/30">·</span>
            <span class="font-mono text-base-content/60">{{ page.visits_count }} {{ 'templates.page.visit_count' | t }}</span>
          {% endif %}
        </div>

        <h1 class="mt-6 text-3xl font-semibold leading-tight tracking-tight text-accent md:text-4xl md:leading-tight">
          {{ page_title }}
        </h1>
      </header>

      {% if page_thumb_image_url %}
        <div class="mb-10 overflow-hidden rounded-box border border-base-300 bg-base-200 md:max-h-[min(50vh,480px)]">
          <img src="{{ page_thumb_image_url }}" alt="" class="w-full object-cover" loading="eager" />
        </div>
      {% endif %}

      {% if page_description %}
        <p class="mb-4 rounded-box border-l-4 border-primary bg-base-200 px-5 py-4 text-base leading-relaxed text-base-content/80">{{ page_description }}</p>
      {% endif %}

      <div class="max-w-full overflow-x-auto">
        <div id="page-content" class="ProseMirror prose max-w-none text-base-content/90 sm:prose-base lg:prose-lg focus:outline-none [&_a]:font-medium [&_a]:text-primary [&_a]:underline-offset-2 [&_h1,&_h2,&_h3,&_h4]:text-accent">
          {{ page_content }}
        </div>
      </div>
    </article>

    {% assign sub_pages_count = page.children_in_list | size %}
    {% if sub_pages_count > 0 %}
      <section class="mt-16 border-t border-base-300 pt-14">
        <h2 class="mb-8 text-lg font-semibold text-accent">{{ 'generic.recent_updates' | t }}</h2>
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {% paginate_tag page.children_in_list, as: 'child_pages', per: 6 %}
            {% for child in child_pages %}
              {% render 'card_grid', page: child %}
            {% else %}
              <div class="col-span-full py-12 text-center text-sm text-base-content/60">{{ 'generic.empty' | t }}</div>
            {% endfor %}
            {% if paginate.total_count > 0 %}
              <div class="col-span-full mt-6 flex justify-center">
                {% render 'paginate', paginate: paginate %}
              </div>
            {% endif %}
          {% endpaginate_tag %}
        </div>
      </section>
    {% endif %}

    <section class="mx-auto mt-14 max-w-4xl border-t border-base-300 pt-10">
      {% render 'feedback_button', page: page %}
    </section>

    {% comment %} 需求收集 - 通过 FormCollection 功能嵌入 {% endcomment %}
    <section class="mx-auto mt-10 max-w-4xl border-t border-base-300 pt-10">
      <div class="mx-auto max-w-md">
        {% form_collection "requirement" %}
      </div>
    </section>
  </div>
</div>

{% schema %}
  {
    "name": "t:schema.templates.page.name",
    "description": "t:schema.templates.page.description",
    "thumb_url": "images/theme/${lang}/page.png",
    "preview_image_urls": [
      "images/theme/${lang}/page.png"
    ],
    "sub_page_templates": ["page"],
    "settings": [
      {
        "id": "title",
        "type": "text",
        "placeholder": "",
        "label": "t:schema.templates.page.settings.title.label",
        "info": "t:schema.templates.page.settings.title.info"
      },
      {
        "id": "description",
        "type": "textarea",
        "to_markdown": true,
        "label": "t:schema.templates.page.settings.description.label"
      },
      {
        "id": "tags",
        "type": "tag_picker",
        "multiple": true,
        "label": "t:schema.templates.page.settings.tags.label"
      },
      {
        "id": "thumb_image_url",
        "type": "image_picker",
        "ratio": "4:1",
        "width": 640,
        "label": "t:schema.templates.page.settings.thumb_image_url.label"
      },
      {
        "id": "content",
        "type": "richtext",
        "to_markdown": true,
        "label": "t:schema.templates.page.settings.content.label"
      }
    ]
  }
{% endschema %}
