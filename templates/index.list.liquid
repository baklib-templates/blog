{% assign pages = site.pages['/'].children_in_list | order_by: '-created_at' %}

<div class="flex-1 bg-base-100">
  {% render 'index_hero', page: page %}

  <div class="page-container py-10 lg:py-14">
    <div class="mb-10 space-y-8 border-b border-base-300 pb-10">
      {% form_tag 'search' %}
        <label class="relative flex max-w-2xl items-center rounded-box border border-base-300 bg-base-200 transition-colors focus-within:border-primary/40 focus-within:bg-base-100">
          <span class="pointer-events-none absolute left-4 text-base-content/40">
            {% render 'icon', name: 'search', class: 'h-5 w-5' %}
          </span>
          <input
            type="search"
            name="{{ form.keywords_field_name }}"
            value="{{ search.keywords | escape_once }}"
            class="w-full rounded-box border-0 bg-transparent py-3.5 pl-12 pr-4 text-sm text-base-content placeholder:text-base-content/40 focus:outline-none focus:ring-0 md:text-base"
            placeholder="{{ 'generic.placeholders.search' | t }}"
            autocomplete="off"
          />
        </label>
      {% endform_tag %}

      {% assign tags_size = site.tags | size %}
      {% if tags_size > 0 %}
        <div class="-mx-1 min-w-0 overflow-x-auto px-1">
          <ul class="flex flex-nowrap gap-x-6 gap-y-2 text-sm font-medium md:gap-x-8">
            <li class="shrink-0">
              <span class="border-b-2 border-accent pb-1 text-accent">{{ 'templates.index.list.all' | t }}</span>
            </li>
            {% for tag in site.tags %}
              <li class="shrink-0">
                <a href="{{ tag.path }}" class="border-b-2 border-transparent pb-1 text-base-content/60 transition-colors hover:text-accent">
                  {{ tag.name }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    </div>

    {% paginate_tag pages, per: 9 %}
      {% for page in pages %}
        {% render 'list', page: page %}
      {% else %}
        <div class="px-6 py-24 text-center text-sm text-base-content/60">{{ 'generic.empty' | t }}</div>
      {% endfor %}

      {% if paginate.total_count > 0 %}
        <div class="mt-14 flex justify-center border-t border-base-300 pt-10">
          {% render 'paginate', paginate: paginate %}
        </div>
      {% endif %}
    {% endpaginate_tag %}
  </div>
</div>

{% schema %}
  {
    "name": "t:schema.templates.index_list.name",
    "description": "t:schema.templates.index_list.description",
    "thumb_url": "images/theme/index-list.png",
    "preview_image_urls": [
      "images/theme/index-list.png"
    ],
    "sub_page_templates": ["page"],
    "settings": [
      {
        "id": "title",
        "type": "text",
        "label": "t:schema.templates.index_hero.settings.title.label",
        "info": "t:schema.templates.index_hero.settings.title.info"
      },
      {
        "id": "description",
        "type": "textarea",
        "label": "t:schema.templates.index_hero.settings.description.label",
        "info": "t:schema.templates.index_hero.settings.description.info"
      },
      {
        "id": "hero_image_url",
        "type": "image_picker",
        "ratio": "21:9",
        "width": 320,
        "label": "t:schema.templates.index_hero.settings.hero_image_url.label"
      }
    ]
  }
{% endschema %}
