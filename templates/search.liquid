<div class="flex-1 bg-base-100">
  <div class="page-container py-10 lg:py-14">
    <div class="mb-10 border-b border-base-300 pb-8">
      <h1 class="mb-6 text-2xl font-semibold tracking-tight text-accent md:text-3xl">{{ 'generic.placeholders.search' | t }}</h1>
      {% form_tag 'search' %}
        <label class="relative flex items-center rounded-box border border-base-300 bg-base-200 transition-colors focus-within:border-primary/40 focus-within:bg-base-100">
          <span class="pointer-events-none absolute left-4 text-base-content/40">
            {% render 'icon', name: 'search', class: 'h-5 w-5' %}
          </span>
          <input
            type="search"
            name="{{ form.keywords_field_name }}"
            value="{{ search.keywords | escape_once }}"
            class="w-full rounded-box border-0 bg-transparent py-3.5 pl-12 pr-4 text-sm text-base-content placeholder:text-base-content/40 focus:outline-none focus:ring-0 md:text-base"
            placeholder="{{ 'generic.placeholders.search' | t }}"
            autocomplete="off"
            x-init="$nextTick(() => { $el.focus(); $el.setSelectionRange($el.value.length, $el.value.length); })"
          />
        </label>
      {% endform_tag %}

      {% if search.keywords or search.tag %}
        <p class="mt-4 text-sm text-base-content/60">
          {% if search.tag %}
            <span class="font-medium text-base-content">{{ search.tag.name }}</span>
          {% endif %}
          {% if search.keywords %}
            {% if search.tag %}<span class="text-base-content/30"> · </span>{% endif %}
            <span>{{ search.keywords }}</span>
          {% endif %}
        </p>
      {% endif %}
    </div>

    {% if search.keywords or search.tag %}
      <div class="min-h-[40vh]">
        {% if search.page_number == 1 %}
          {% for link in search.extends %}
            <div class="mb-6 rounded-box border border-base-300 bg-base-200/50 p-5 transition-colors hover:border-base-300 hover:bg-base-200">
              <a class="search-highlight-block text-base font-semibold text-accent hover:text-base-content/70 md:text-lg" href="{{ link.url }}">{{ link.link_text }}</a>
              <p class="mt-2 line-clamp-2 text-xs text-base-content/50 md:text-sm">{{ link.url }}</p>
            </div>
          {% endfor %}
        {% endif %}

        {% paginate_tag search.pages, as: 'items' %}
          <ul class="list-none divide-y divide-base-300 border-t border-base-300">
            {% for result in items %}
              <li class="py-6 first:pt-0 md:py-8">
                <a href="{{ result.path }}" class="group block">
                  <h2 class="search-highlight-block text-lg font-semibold tracking-tight text-accent group-hover:text-base-content/70 md:text-xl">
                    {{ result.highlighted_search_title }}
                  </h2>
                  <p class="search-highlight-block mt-2 line-clamp-3 text-sm leading-relaxed text-base-content/60 md:line-clamp-4 md:text-[15px]">
                    {{ result.highlighted_search_content }}
                  </p>
                  <p class="mt-3 font-mono text-xs text-base-content/40">{{ result.path }}</p>
                </a>
              </li>
            {% else %}
              <li class="py-24 text-center text-sm text-base-content/60">{{ 'generic.empty' | t }}</li>
            {% endfor %}
          </ul>

          {% if paginate.total_count > 0 %}
            <div class="mt-14 flex justify-center border-t border-base-300 pt-10">
              {% render 'paginate', paginate: paginate %}
            </div>
          {% endif %}
        {% endpaginate_tag %}
      </div>
    {% else %}
      <p class="py-16 text-center text-sm text-base-content/60">{{ 'generic.empty' | t }}</p>
    {% endif %}
  </div>
</div>
