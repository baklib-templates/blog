<form action="{{ collection.submit_url }}" method="post" class="space-y-4">
  <input type="hidden" name="authenticity_token" value="{{ context.authenticity_token }}" />

  <p class="text-sm text-base-content/70">{{ 'forms.subscribe.description' | t }}</p>

  <fieldset class="fieldset">
    <legend class="fieldset-legend">{{ 'forms.subscribe.email_label' | t }}</legend>
    <input type="email" name="data[email]" required class="w-full input" placeholder="{{ 'forms.subscribe.email_placeholder' | t }}" />
  </fieldset>

  <div class="flex items-center gap-2">
    <button type="submit" class="btn btn-primary">{{ collection.submit_text | default: 'forms.subscribe.submit' | t }}</button>
  </div>
</form>
