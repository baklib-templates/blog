<header
  class="fixed inset-x-0 top-0 z-50 flex w-full min-h-[var(--header-height)] items-center border-b border-base-300 bg-base-100/95 text-base-content backdrop-blur supports-[backdrop-filter]:bg-base-100/80"
>
  <div class="page-container flex items-center gap-3 py-3 md:gap-6">
    {% assign fallback_logo = 'images/logo.png' | asset_url %}
    {% assign custom_logo_url = site.settings.logo_url | presence %}

    <a
      href="{{ site.index_path }}"
      class="flex min-w-0 flex-1 items-center gap-2 md:flex-none md:max-w-[min(50%,20rem)] md:gap-3"
      aria-label="{{ site.name }}"
    >
      {% if custom_logo_url %}
        <img
          src="{{ custom_logo_url }}"
          alt="{{ site.name }}"
          class="h-6 w-auto max-w-full object-contain md:h-8"
          loading="eager"
        />
      {% else %}
        <span class="flex h-9 w-9 shrink-0 items-center justify-center overflow-hidden rounded-full border border-base-300 bg-base-200">
          <img
            src="{{ site.favicon_url | default: fallback_logo }}"
            alt=""
            class="h-full w-full object-cover"
            onerror="this.onerror=null;this.src='{{ fallback_logo }}';"
          />
        </span>
        <span class="min-w-0 truncate text-base font-semibold tracking-tight text-base-content md:text-lg">{{ site.name }}</span>
      {% endif %}
    </a>

    <div class="shrink-0 md:hidden">
      {% render 'header_drawer' %}
    </div>

    <div class="hidden min-w-0 flex-1 items-center justify-end gap-6 md:flex">
      <nav
        aria-label="Primary"
        class="flex min-w-0 flex-wrap items-center justify-end gap-x-3 gap-y-1 [&_a]:text-sm [&_a]:font-medium [&_a]:text-base-content/70 [&_a]:transition-colors [&_a]:hover:text-accent md:gap-x-4"
      >
        {{ site.settings.header_menu_html }}
      </nav>

      {% if site.search_path or current_user %}
        <div class="flex shrink-0 items-center gap-4 border-l border-base-300 pl-6">
          {% if site.search_path %}
            <a
              href="{{ site.search_path }}"
              class="flex h-9 w-9 items-center justify-center rounded-field text-base-content/70 transition-colors hover:bg-base-200 hover:text-accent"
              aria-label="{{ 'generic.placeholders.search' | t }}"
            >
              {% render 'icon', name: 'search', class: 'h-5 w-5' %}
            </a>
          {% endif %}

          {% if current_user %}
            <div class="dropdown dropdown-end">
              <div tabindex="0" role="button" class="avatar flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-base-200 ring-1 ring-base-300">
                {% if current_user.image %}
                  <img src="{{ current_user.image }}" alt="" class="h-9 w-9 rounded-full object-cover" />
                {% else %}
                  {% render 'icon', name: 'user', class: 'h-5 w-5 text-base-content/50' %}
                {% endif %}
              </div>
              <div tabindex="0" class="dropdown-content mt-2 w-44 space-y-2 rounded-box border border-base-300 bg-base-100 py-2 px-3 shadow-lg">
                <div class="line-clamp-1 border-b border-base-300 pb-2 text-sm font-medium text-base-content">{{ current_user.name }}</div>
                <div class="text-base-content/70">
                  {% form_tag 'sign_out' %}
                    <button type="submit" class="hover:link w-full text-left text-sm">{{ 'generic.buttons.signout' | t }}</button>
                  {% endform_tag %}
                </div>
              </div>
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</header>
