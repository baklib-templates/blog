<div class="space-y-4">
  {% form_tag 'search' %}
    <label class="input">
      {% render 'icon', name: 'search', class: 'h-[1em] opacity-50' %}
      <input type="search" class="grow" name="{{form.keywords_field_name}}" value="{{ search.keywords | escape }}" placeholder="{{ 'generic.placeholders.search' | t }}" />
    </label>
  {% endform_tag %}

  {%- assign header_menu_html = site.settings.header_menu_html -%}
  {% if header_menu_html %}
    <div class="card bg-base-100 p-4">
      <div class="flex flex-col space-y-2 pt-2 underline">
        {{ header_menu_html }}
      </div>
    </div>
  {% endif %}

  {%- assign tags = site.tags -%}
  {%- assign tags_count = tags | size -%}

  {% if tags_count > 0 %}
    <div class="card bg-base-100 p-4">
      <label class="mb-3 block font-mono text-xs font-semibold text-base-content/60">{{ 'generic.tags_heading' | t }}</label>
      <ul role="list" class="flex flex-col">
        {% for tag in site.tags %}
          <li>
            <a
              href="{{ tag.path }}"
              style="--tag-color: {{ tag.color }};"
              class="flex items-center space-x-2 py-1.5 transition-all duration-300 ease-in-out"
            >
              <span class="h-2 w-2 shrink-0 rounded-full" style="background-color: {{ tag.color }};"></span>
              <span class="flex-grow break-words text-base-content/60 hover:text-[var(--tag-color)]">
                {{ tag.name }}
              </span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</div>
