<div class="drawer drawer-end ml-auto flex w-10 shrink-0 items-center justify-end md:hidden">
  <input id="header-drawer-right" type="checkbox" class="drawer-toggle" x-init="$el.checked = false;" />
  <div class="drawer-content">
    <label for="header-drawer-right" class="drawer-button btn btn-ghost btn-square text-base-content hover:bg-base-200">
      {% render 'icon', name: 'menu', class: 'size-6 h-6 w-6' %}
    </label>
  </div>
  <div class="drawer-side">
    <label
      for="header-drawer-right"
      aria-label="{{ 'generic.accessibility.close_sidebar' | t }}"
      class="drawer-overlay"
    ></label>
    <div class="bg-base-200 text-base-content min-h-full w-80 p-4">
      {% render 'sidebar', site: site %}
    </div>
  </div>
</div>
