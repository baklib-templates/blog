{% comment %}
  @params breadcrumb
    array of objects with keys: link_text, path
  @params page (optional)
    current page — shows page tools on the right when present
  Sticky bar under site header; visual style aligned with features/subnav.
{% endcomment %}

{% assign crumbs_size = breadcrumb | size %}
{% if crumbs_size > 0 or page %}
  <div class="page-breadcrumb-subnav print:hidden">
    <div class="page-container">
      <div class="page-breadcrumb-subnav__inner">
        {% if crumbs_size > 0 %}
          <nav class="features-subnav-scroll page-breadcrumb-subnav__trail" aria-label="{{ 'generic.breadcrumb_nav' | t }}">
            {% for crumb in breadcrumb %}
              {% if forloop.index0 == 0 %}
                {% assign crumb_label = 'generic.home' | t %}
              {% else %}
                {% assign crumb_label = crumb.link_text %}
              {% endif %}
              {% if forloop.last %}
                <span class="index-tab-btn index-tab-btn--active shrink-0 whitespace-nowrap" aria-current="page">
                  {{ page.slug }}
                </span>
              {% else %}
                <a href="{{ crumb.path }}" class="index-tab-btn shrink-0 whitespace-nowrap">
                  {{ crumb_label }}
                </a>
              {% endif %}
              {% unless forloop.last %}
                <span class="shrink-0 text-base-content/50" aria-hidden="true">/</span>
              {% endunless %}
            {% endfor %}
          </nav>
        {% else %}
          <div class="min-w-0 flex-1" aria-hidden="true"></div>
        {% endif %}
        {% if page %}
          <div class="page-breadcrumb-subnav__tools">
            {% render 'page_tools_dropdown', page: page %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}
