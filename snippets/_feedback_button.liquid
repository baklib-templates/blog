{% if site.settings.is_allow_feedback %}
  <div id="js--feedback-{{ page.id }}" class="flex w-full flex-col items-center justify-center space-y-3 print:hidden">
    <a
      data-turbo-stream="true"
      href="{{ page.feedback_path }}"
      class="flex h-14 w-14 cursor-pointer items-center justify-center rounded-full border-2 transition-all duration-300 hover:-translate-y-2
      {% if page.visitor_posted_feedback %}
      border-primary bg-base-100 text-primary
      {% else %}
      border-base-300 text-base-content/40 hover:border-base-content/50 hover:text-base-content/60
      {% endif %}
      "
    >
      {% render 'icon', name: 'thumbs-up', class: 'h-6 w-6' %}
    </a>
    {% if page.visitor_posted_feedback %}
        <span class="w-full text-center text-sm">{{ 'snippets.feedback_button.title_posted' | t}}</span>
    {% else %}
        <span class="w-full text-center text-sm">{{ 'snippets.feedback_button.title_unposted' | t}}</span>
    {% endif %}
  </div>
{% endif %}
