{% comment %} Grid card: cover image + title + tags · date (index / tag pages) {% endcomment %}

{% assign thumb_image_url = page.settings.thumb_image_url | presence %}
{% assign first_tag = page.settings.tags | first %}

<article class="group index-card">
  <a href="{{ page.path }}" class="index-card__media">
    {% if thumb_image_url %}
      <img src="{{ thumb_image_url }}" alt="" loading="lazy" />
    {% else %}
      <div class="index-card__placeholder" aria-hidden="true">
        {% render 'icon', name: 'image', class: 'h-12 w-12' %}
      </div>
    {% endif %}
  </a>

  <div class="index-card__body">
    <h2 class="index-card__title">
      <a href="{{ page.path }}">{{ page.link_text }}</a>
    </h2>

    <p class="index-card__meta">
      {% if first_tag %}
        <span class="text-base-content/70">{{ first_tag.name }}</span>
        {% if page.published_at %}
          <span class="mx-1 text-base-content/30" aria-hidden="true">·</span>
        {% endif %}
      {% endif %}
      {% if page.published_at %}
        <time datetime="{{ page.published_at | date: '%Y-%m-%d' }}">{{ page.published_at | date: '%Y-%m-%d' }}</time>
      {% endif %}
    </p>
  </div>
</article>
